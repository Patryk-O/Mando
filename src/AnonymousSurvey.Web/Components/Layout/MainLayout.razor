@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="app-header__inner">
            <span class="app-header__logo" aria-hidden="true">✓</span>
            <span class="app-header__title">Ankieta anonimowa</span>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        Odpowiedzi są w pełni anonimowe — nie zbieramy danych osobowych ani adresów IP.
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież</a>
    <span class="dismiss">🗙</span>
</div>
