<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <base href="/" />
    <ResourcePreloader />
    @DxResourceManager.RegisterTheme(Themes.OfficeWhite)
    @DxResourceManager.RegisterScripts()
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AnonymousSurvey.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveNoPrerender" />
</head>

<body>
    <Routes @rendermode="InteractiveNoPrerender" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static readonly InteractiveServerRenderMode InteractiveNoPrerender = new(prerender: false);
}
