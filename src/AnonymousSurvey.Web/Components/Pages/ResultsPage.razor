@page "/wyniki/{Token}"
@inherits BasePage
@inject ISurveyResultsQuery ResultsQuery

<PageShell Title="@PageTitle" IsLoading="IsLoading" Error="@LoadError" OnRetry="ReloadAsync" IsNotFound="IsNotFound">
    @if (_results is not null)
    {
        <div class="stat-row">
            <div class="stat">
                <span class="stat__value">@_results.TotalSessions</span>
                <span class="stat__label">Wypełnionych ankiet</span>
            </div>
            <DxButton Text="Odśwież" RenderStyle="ButtonRenderStyle.Secondary" Click="ReloadAsync" />
        </div>

        @if (_results.TotalSessions == 0)
        {
            <div class="state-box">
                <p>Nie ma jeszcze żadnych odpowiedzi.</p>
            </div>
        }
        else
        {
            <h2 class="section-title">Podsumowanie</h2>
            <div class="aggregate-list">
                @foreach (var item in _results.ScaleAggregates)
                {
                    <article class="aggregate">
                        <h3>
                            <span class="aggregate__title">@item.Text</span>
                            @if (!item.IsCurrentlyAssigned)
                            {
                                <span class="badge badge--removed">usunięte z ankiety</span>
                            }
                        </h3>
                        <p class="aggregate__count">@ResponseLine(item.AnsweredCount, item.EligibleCount, item.IsCurrentlyAssigned)</p>
                        @if (item.AnsweredCount > 0)
                        {
                            <p class="aggregate__value">Średnia: <strong>@item.Average.ToString("0.00")</strong> / 5</p>
                        }
                        @if (ShowBreakdown(item.IsCurrentlyAssigned, item.EligibleCount, item.AnsweredCount))
                        {
                            @foreach (var step in item.Distribution.OrderByDescending(d => d.Key))
                            {
                                <div class="bar-row">
                                    <span class="bar-row__label">@step.Key</span>
                                    <div class="bar"><div class="bar__fill" style="width:@Percent(step.Value, item.Distribution.Values.Sum())%"></div></div>
                                    <span class="bar-row__count">@step.Value</span>
                                </div>
                            }
                        }
                    </article>
                }

                @foreach (var item in _results.YesNoAggregates)
                {
                    var total = item.YesCount + item.NoCount;
                    <article class="aggregate">
                        <h3>
                            <span class="aggregate__title">@item.Text</span>
                            @if (!item.IsCurrentlyAssigned)
                            {
                                <span class="badge badge--removed">usunięte z ankiety</span>
                            }
                        </h3>
                        <p class="aggregate__count">@ResponseLine(item.AnsweredCount, item.EligibleCount, item.IsCurrentlyAssigned)</p>
                        @if (ShowBreakdown(item.IsCurrentlyAssigned, item.EligibleCount, item.AnsweredCount))
                        {
                            <div class="bar-row">
                                <span class="bar-row__label">Tak</span>
                                <div class="bar"><div class="bar__fill" style="width:@Percent(item.YesCount, total)%"></div></div>
                                <span class="bar-row__count">@item.YesCount</span>
                            </div>
                            <div class="bar-row">
                                <span class="bar-row__label">Nie</span>
                                <div class="bar"><div class="bar__fill bar__fill--alt" style="width:@Percent(item.NoCount, total)%"></div></div>
                                <span class="bar-row__count">@item.NoCount</span>
                            </div>
                        }
                    </article>
                }

                @foreach (var item in _results.OpenAggregates)
                {
                    <article class="aggregate">
                        <h3>
                            <span class="aggregate__title">@item.Text</span>
                            @if (!item.IsCurrentlyAssigned)
                            {
                                <span class="badge badge--removed">usunięte z ankiety</span>
                            }
                        </h3>
                        <p class="aggregate__count">@ResponseLine(item.AnsweredCount, item.EligibleCount, item.IsCurrentlyAssigned)</p>
                    </article>
                }
            </div>

            <h2 class="section-title">Wszystkie odpowiedzi</h2>
            <DxGrid Data="_rows"
                    PageSize="15"
                    PageSizeSelectorVisible="true"
                    PageSizeSelectorItems="@(new[] { 10, 15, 30, 50 })"
                    ShowFilterRow="true"
                    CssClass="results-grid">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(ResultRow.SubmittedAt)" Caption="Data" DisplayFormat="dd.MM.yyyy HH:mm" Width="160px" />
                    <DxGridDataColumn FieldName="@nameof(ResultRow.SessionShortId)" Caption="Zgłoszenie" Width="120px" />
                    <DxGridDataColumn FieldName="@nameof(ResultRow.Question)" Caption="Pytanie" />
                    <DxGridDataColumn FieldName="@nameof(ResultRow.Answer)" Caption="Odpowiedź" />
                </Columns>
            </DxGrid>
        }
    }
</PageShell>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private SurveyResultsDto? _results;
    private List<ResultRow> _rows = [];

    protected override string PageTitle => _results is null ? "Wyniki ankiety" : $"Wyniki — {_results.SurveyTitle}";

    protected override async Task LoadAsync(CancellationToken cancellationToken)
    {
        _results = await ResultsQuery.GetByResultsTokenAsync(Token, cancellationToken);
        IsNotFound = _results is null;
        _rows = _results is null ? [] : BuildRows(_results);
    }

    private static string ResponseLine(int answered, int eligible, bool assigned)
    {
        if (!assigned)
        {
            return $"{answered} odpowiedzi";
        }

        if (eligible == 0)
        {
            return "Brak odpowiedzi";
        }

        return $"Odpowiedziało {answered} z {eligible}";
    }

    private static bool ShowBreakdown(bool assigned, int eligible, int answered) =>
        assigned ? eligible > 0 : answered > 0;

    private static double Percent(int value, int total) =>
        total == 0 ? 0 : Math.Round(value * 100.0 / total, 1, MidpointRounding.AwayFromZero);

    private static List<ResultRow> BuildRows(SurveyResultsDto results)
    {
        var questions = new Dictionary<int, (string Text, QuestionType Type)>();
        foreach (var scale in results.ScaleAggregates) questions[scale.QuestionId] = (scale.Text, QuestionType.Scale);
        foreach (var yesNo in results.YesNoAggregates) questions[yesNo.QuestionId] = (yesNo.Text, QuestionType.YesNo);
        foreach (var open in results.OpenAggregates) questions[open.QuestionId] = (open.Text, QuestionType.Open);

        var rows = new List<ResultRow>();
        foreach (var response in results.RawResponses)
        {
            var submittedAt = DateTime.SpecifyKind(response.SubmittedAtUtc, DateTimeKind.Utc).ToLocalTime();
            foreach (var answer in response.Answers.OrderBy(a => a.QuestionId))
            {
                if (answer.IsEmpty || !questions.TryGetValue(answer.QuestionId, out var question))
                {
                    continue;
                }

                var display = question.Type switch
                {
                    QuestionType.Scale => answer.ScaleValue?.ToString() ?? "—",
                    QuestionType.YesNo => answer.BoolValue switch { true => "Tak", false => "Nie", _ => "—" },
                    _ => answer.TextValue ?? "—"
                };

                rows.Add(new ResultRow(submittedAt, response.SessionId.ToString("N")[..8], question.Text, display));
            }
        }

        return rows;
    }

    private sealed record ResultRow(DateTime SubmittedAt, string SessionShortId, string Question, string Answer);
}
