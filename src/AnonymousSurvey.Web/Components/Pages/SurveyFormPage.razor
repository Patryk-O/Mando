@page "/ankieta/{Slug}"
@inherits BasePage
@using AnonymousSurvey.Application.Common
@using AnonymousSurvey.Application.Services
@inject ISurveyCatalogQuery Catalog
@inject ISurveyQuestionQuery QuestionQuery
@inject ISurveyResponseValidator Validator
@inject ISurveySubmissionService SubmissionService

<PageShell Title="@PageTitle" IsLoading="IsLoading" Error="@LoadError" OnRetry="ReloadAsync" IsNotFound="IsNotFound">
    @if (_survey is not null && (_survey.Status == SurveyStatus.Closed || _replacedByClosure))
    {
        <div class="state-box">
            <p>@(_closureMessage ?? "Ta ankieta jest zamknięta i nie przyjmuje już odpowiedzi.")</p>
        </div>
    }
    else if (_survey is not null && _questions.Count == 0)
    {
        @if (_summaryErrors.Count > 0)
        {
            <div class="state-box state-box--error" role="alert">
                <ul>
                    @foreach (var message in _summaryErrors)
                    {
                        <li>@message</li>
                    }
                </ul>
            </div>
        }
        <div class="state-box">
            <p>Ankieta nie zawiera jeszcze pytań.</p>
        </div>
    }
    else if (_survey is not null)
    {
        @if (!string.IsNullOrWhiteSpace(_survey.Description))
        {
            <p class="survey-description">@_survey.Description</p>
        }

        <p class="lead">Pola oznaczone * są wymagane.</p>

        @if (_summaryErrors.Count > 0)
        {
            <div class="state-box state-box--error" role="alert">
                <ul>
                    @foreach (var message in _summaryErrors)
                    {
                        <li>@message</li>
                    }
                </ul>
            </div>
        }

        <div class="question-list">
            @for (var i = 0; i < _questions.Count; i++)
            {
                var question = _questions[i];
                <QuestionInput @key="question.QuestionId"
                               Question="question"
                               Model="_models[question.QuestionId]"
                               Number="i + 1"
                               Error="@GetError(question.QuestionId)"
                               OnAnswerChanged="() => OnAnswerChanged(question)" />
            }
        </div>

        <div class="form-actions">
            <DxButton Text="@(_submitting ? "Wysyłanie…" : "Wyślij odpowiedzi")"
                      RenderStyle="ButtonRenderStyle.Primary"
                      Enabled="!_submitting"
                      Click="SubmitAsync" />
        </div>
    }
</PageShell>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private SurveyPublicDto? _survey;
    private IReadOnlyList<SurveyQuestionDto> _questions = [];
    private readonly Dictionary<int, AnswerFormModel> _models = [];
    private readonly Dictionary<int, string> _errors = [];
    private readonly List<string> _summaryErrors = [];
    private bool _submitting;
    private bool _replacedByClosure;
    private string? _closureMessage;

    protected override string PageTitle => _survey?.Title ?? "Ankieta";

    protected override async Task LoadAsync(CancellationToken cancellationToken)
    {
        _models.Clear();
        _errors.Clear();
        _summaryErrors.Clear();
        _submitting = false;
        _replacedByClosure = false;
        _closureMessage = null;

        _survey = await Catalog.GetBySlugAsync(Slug, cancellationToken);
        IsNotFound = _survey is null;
        if (_survey is null || _survey.Status != SurveyStatus.Active)
        {
            _questions = [];
            return;
        }

        ApplyQuestions(await QuestionQuery.GetQuestionsAsync(_survey.SurveyId, cancellationToken));
    }

    private string? GetError(int questionId) => _errors.GetValueOrDefault(questionId);

    private void OnAnswerChanged(SurveyQuestionDto question)
    {
        if (!_errors.ContainsKey(question.QuestionId))
        {
            return;
        }

        var result = Validator.Validate(_models[question.QuestionId].ToDto(), question);
        if (result.IsValid)
        {
            _errors.Remove(question.QuestionId);
        }
        else
        {
            _errors[question.QuestionId] = result.Errors[0];
        }
    }

    private async Task SubmitAsync()
    {
        // Guard w kodzie: drugi klik w tym samym obiegu nie zapisuje drugiej odpowiedzi.
        if (_submitting || _survey is null || _replacedByClosure || _survey.Status != SurveyStatus.Active)
        {
            return;
        }

        _submitting = true;
        var navigated = false;
        try
        {
            _errors.Clear();
            _summaryErrors.Clear();

            var answers = _questions.Select(question => _models[question.QuestionId].ToDto()).ToList();
            foreach (var question in _questions)
            {
                var single = Validator.Validate(_models[question.QuestionId].ToDto(), question);
                if (!single.IsValid)
                {
                    _errors[question.QuestionId] = single.Errors[0];
                }
            }

            var clientValidation = Validator.Validate(answers, _questions);
            if (!clientValidation.IsValid)
            {
                _summaryErrors.AddRange(clientValidation.Errors);
                return;
            }

            var outcome = await SubmissionService.SubmitAsync(
                new SubmitSurveyResponseDto(_survey.SurveyId, answers),
                PageCancellation);

            if (outcome.Succeeded)
            {
                navigated = true;
                Navigation.NavigateTo($"/ankieta/{_survey.Slug}/dziekujemy");
                return;
            }

            if (outcome.Conflict == SubmissionConflict.SurveyClosed)
            {
                _replacedByClosure = true;
                _closureMessage = outcome.Validation.Errors.FirstOrDefault()
                    ?? "Ta ankieta została zamknięta i nie przyjmuje już odpowiedzi.";
                return;
            }

            var fresh = await QuestionQuery.GetQuestionsAsync(_survey.SurveyId, PageCancellation);
            if (outcome.Conflict == SubmissionConflict.FormChanged || AnswerFormModel.ShapeChanged(_questions, fresh))
            {
                if (outcome.Conflict == SubmissionConflict.FormChanged)
                {
                    _summaryErrors.AddRange(outcome.Validation.Errors);
                }
                else
                {
                    _summaryErrors.Add(SurveySubmissionService.FormChangedMessage);
                }

                ApplyQuestions(fresh);
                return;
            }

            _summaryErrors.AddRange(outcome.Validation.Errors);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Błąd zapisu odpowiedzi ankiety.");
            _summaryErrors.Add("Nie udało się zapisać odpowiedzi. Spróbuj ponownie za chwilę.");
        }
        finally
        {
            if (!navigated)
            {
                _submitting = false;
            }
        }
    }

    private void ApplyQuestions(IReadOnlyList<SurveyQuestionDto> questions)
    {
        var carried = AnswerFormModel.CarryOver(_models, questions);
        _questions = questions;
        _models.Clear();
        foreach (var (questionId, model) in carried)
        {
            _models[questionId] = model;
        }

        _errors.Clear();
    }
}
