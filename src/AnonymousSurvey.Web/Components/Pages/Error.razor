@page "/Error"
@using System.Diagnostics

<PageTitle>Błąd</PageTitle>

<section class="page-shell">
    <h1 class="page-shell__title">Wystąpił błąd</h1>
    <div class="state-box state-box--error">
        <p>Nie udało się przetworzyć żądania. Spróbuj ponownie za chwilę.</p>
        @if (ShowRequestId)
        {
            <p class="muted">Identyfikator żądania: <code>@RequestId</code></p>
        }
    </div>
    <a href="/">Wróć do ankiety</a>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
